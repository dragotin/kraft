<?xml version="1.0" encoding="UTF-8"?>
<ubl:Invoice xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
             xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
             xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
    <cbc:CustomizationID>urn:cen.eu:en16931:2017#compliant#urn:xeinkauf.de:kosit:xrechnung_3.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:fdc:peppol.eu:2017:poacc:billing:01:1.0</cbc:ProfileID>
    <cbc:ID>{{ doc.ident }}</cbc:ID>
    <cbc:IssueDate>{{ doc.dateStrISO }}</cbc:IssueDate>
    <cbc:DueDate>{{ xrechnung.dueDate }}</cbc:DueDate>
    <cbc:InvoiceTypeCode>380</cbc:InvoiceTypeCode>
    <cbc:Note>#ADU#Es gelten unsere Allgem. Geschäftsbedingungen, die Sie unter […] finden.</cbc:Note>
    <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>
    <cbc:BuyerReference>{{ xrechnung.buyerRef }}</cbc:BuyerReference>
    {% if doc.timeOfSupplyValid %}
    <cac:InvoicePeriod>
        <cbc:StartDate>{{ doc.timeOfSupplyStartISO }}</cbc:StartDate>
        {% if doc.timeOfSupplyMultiDay %}
        <cbc:EndDate>{{ doc.timeOfSupplyEndISO }}</cbc:EndDate>
        {% endif %}
    </cac:InvoicePeriod>
    {% endif %}
    <cac:ProjectReference>
      <cbc:ID>{{ doc.projectLabel }}</cbc:ID>
   </cac:ProjectReference>
   
   <cac:AccountingSupplierParty>
       <cac:Party>
           <cbc:EndpointID schemeID="EM">{{ me.EMAIL }}</cbc:EndpointID>
           <cac:PartyName>
               <cbc:Name>{{ me.ORGANISATION }}</cbc:Name>
           </cac:PartyName>
           <cac:PostalAddress>
               <cbc:StreetName>{{ me.STREET }}</cbc:StreetName>
               {% if me.EXTENDED %}
               <cbc:AdditionalStreetName>{{ me.EXTENDED }}</cbc:AdditionalStreetName>
               {% endif %}
               <cbc:CityName>{{ me.LOCALITY }}</cbc:CityName>
               <cbc:PostalZone>{{ me.POSTCODE }}</cbc:PostalZone>
               <cac:Country>
                   <cbc:IdentificationCode>{{ me.COUNTRYCODE }}</cbc:IdentificationCode>
               </cac:Country>
           </cac:PostalAddress>
           {% if me.VATID %}
           <cac:PartyTaxScheme>
               <cbc:CompanyID>{{ me.VATID }}</cbc:CompanyID>
               <cac:TaxScheme>
                   <cbc:ID>VAT</cbc:ID>
               </cac:TaxScheme>
           </cac:PartyTaxScheme>
           {% endif %}
           {% if me.TAXNUMBER %}
           <cac:PartyTaxScheme>
               <cbc:CompanyID>{{ me.TAXNUMBER }}</cbc:CompanyID>
               <cac:TaxScheme>
                   <cbc:ID>FC</cbc:ID>
               </cac:TaxScheme>
           </cac:PartyTaxScheme>
           {% endif %}
           <cac:PartyLegalEntity>
               <cbc:RegistrationName>{{ me.ORGANISATION }}</cbc:RegistrationName>
               {% if me.REGISTRATIONID %}
               <cbc:CompanyID>{{ me.REGISTRATIONID }}</cbc:CompanyID>
               {% endif %}
               {% if me.LEGALFORM %}
               <cbc:CompanyLegalForm>{{ me.LEGALFORM }}</cbc:CompanyLegalForm>
               {% endif %}
           </cac:PartyLegalEntity>
           <cac:Contact>
               <cbc:Name>{{ me.NAME }}</cbc:Name>
               <cbc:Telephone>{% if me.PHONE %}{{ me.PHONE }}{% else %}{{ me.MOBILE }}{% endif %}</cbc:Telephone>
               <cbc:ElectronicMail>{{ me.EMAIL }}</cbc:ElectronicMail>
           </cac:Contact>
        </cac:Party>
    </cac:AccountingSupplierParty>
    
   <cac:AccountingCustomerParty>
        <cac:Party>
            <cbc:EndpointID schemeID="EM">{{ customer.EMAIL }}</cbc:EndpointID>
            <cac:PartyName><cbc:Name>{{ customer.NAME }}</cbc:Name></cac:PartyName> 
            <cac:PostalAddress>
                <cbc:StreetName>{{ customer.STREET }}</cbc:StreetName>
                <cbc:CityName>{{ customer.LOCALITY }}</cbc:CityName>
                <cbc:PostalZone>{{ customer.POSTCODE }}</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>DE</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            {% if customer.VATID %}
            <!-- BT-48, only for a customer that is registered for VAT. Set it in
                 the Kraft data of the contact. -->
            <cac:PartyTaxScheme>
                <cbc:CompanyID>{{ customer.VATID }}</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            {% endif %}
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>{{ customer.ORGANISATION }}</cbc:RegistrationName>
            </cac:PartyLegalEntity>
            <cac:Contact>
                <cbc:Name>{{ customer.NAME }}</cbc:Name>
                {% if customer.EMAIL %}
                <cbc:ElectronicMail>{{ customer.EMAIL }}</cbc:ElectronicMail>
                {% endif %}
                {% if customer.PHONE %}
                <cbc:Telephone>{{ customer.PHONE }}</cbc:Telephone>
                {% endif %}
            </cac:Contact>
        </cac:Party>
    </cac:AccountingCustomerParty>
    <cac:PaymentMeans>
        <cbc:PaymentMeansCode>58</cbc:PaymentMeansCode>
        <cac:PayeeFinancialAccount>
            <cbc:ID>{{ me.IBAN }}</cbc:ID>
            {% if me.ACCOUNTNAME %}
            <cbc:Name>{{ me.ACCOUNTNAME }}</cbc:Name>
            {% endif %}
            {% if me.BIC %}
            <cac:FinancialInstitutionBranch>
                <cbc:ID>{{ me.BIC }}</cbc:ID>
            </cac:FinancialInstitutionBranch>
            {% endif %}
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>
    <cac:PaymentTerms>
        <cbc:Note>Zahlbar sofort ohne Abzug.</cbc:Note>
    </cac:PaymentTerms>
    <!-- One TaxSubtotal per VAT rate that actually occurs in the document. A single
         subtotal over the whole netto sum breaks BR-S-09 as soon as the document
         mixes the full and the reduced rate. -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="EUR">{{ doc.taxSumNum }}</cbc:TaxAmount>

        {% if doc.noTaxesDocument %}
            <cac:TaxSubtotal>
                <cbc:TaxableAmount currencyID="EUR">{{ doc.noTaxNettoSumNum }}</cbc:TaxableAmount>
                <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
                <cac:TaxCategory>
                    <cbc:ID>Z</cbc:ID>
                    <cbc:Percent>0.00</cbc:Percent>
                    <cac:TaxScheme>
                        <cbc:ID>VAT</cbc:ID>
                    </cac:TaxScheme>
                </cac:TaxCategory>
            </cac:TaxSubtotal>
        {% else %}
            <!-- the document has taxes -->
            {% if doc.hasFullTaxItems %}
            <cac:TaxSubtotal>
                <cbc:TaxableAmount currencyID="EUR">{{ doc.fullTaxNettoSumNum }}</cbc:TaxableAmount>
                <cbc:TaxAmount currencyID="EUR">{{ doc.fullTaxSumNum }}</cbc:TaxAmount>
                <cac:TaxCategory>
                    <cbc:ID>S</cbc:ID>
                    <cbc:Percent>{{ doc.fullTaxPercentNum }}</cbc:Percent>
                    <cac:TaxScheme>
                        <cbc:ID>VAT</cbc:ID>
                    </cac:TaxScheme>
                </cac:TaxCategory>
            </cac:TaxSubtotal>
            {% endif %}
            {% if doc.hasReducedTaxItems %}
            <cac:TaxSubtotal>
                <cbc:TaxableAmount currencyID="EUR">{{ doc.reducedTaxNettoSumNum }}</cbc:TaxableAmount>
                <cbc:TaxAmount currencyID="EUR">{{ doc.reducedTaxSumNum }}</cbc:TaxAmount>
                <cac:TaxCategory>
                    <cbc:ID>S</cbc:ID>
                    <cbc:Percent>{{ doc.reducedTaxPercentNum }}</cbc:Percent>
                    <cac:TaxScheme>
                        <cbc:ID>VAT</cbc:ID>
                    </cac:TaxScheme>
                </cac:TaxCategory>
            </cac:TaxSubtotal>
            {% endif %}
        {% endif %}

    </cac:TaxTotal>
    
    <cac:LegalMonetaryTotal>
      <cbc:LineExtensionAmount currencyID="EUR">{{ doc.nettoSumNum }}</cbc:LineExtensionAmount>
      <cbc:TaxExclusiveAmount currencyID="EUR">{{ doc.nettoSumNum }}</cbc:TaxExclusiveAmount>
      <cbc:TaxInclusiveAmount currencyID="EUR">{{ doc.bruttoSumNum }}</cbc:TaxInclusiveAmount>
      <cbc:PayableAmount currencyID="EUR">{{ doc.bruttoSumNum }}</cbc:PayableAmount>
   </cac:LegalMonetaryTotal>

   {% for item in doc.items %}
   <cac:InvoiceLine>
        <cbc:ID>{{ item.itemNumber }}</cbc:ID>
        <cbc:InvoicedQuantity unitCode="{{ item.unitCode }}">{{ item.amountNum }}</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">{{ item.nettoPriceNum }}</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>{{ item.htmlText }}</cbc:Description>
            <cbc:Name>{{ item.htmlText }}</cbc:Name>
            <cac:SellersItemIdentification>
                <cbc:ID>{{ item.itemNumber }}</cbc:ID>
            </cac:SellersItemIdentification>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>{{ item.taxCategory }}</cbc:ID>
                <cbc:Percent>{{ item.taxPercentNum }}</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">{{ item.unitPriceNum }}</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
    {% endfor %}

</ubl:Invoice>
